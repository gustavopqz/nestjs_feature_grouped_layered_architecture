# Root credentials (used only on first initialization)
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Default database (created on init)
MONGO_DB_NAME=

# App credentials (used by backend - NOT root)
MONGO_APP_USERNAME=
MONGO_APP_PASSWORD=

# App connection string (recommended)
MONGO_URI=

# JWT signing secret (used for employee authentication)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Bootstrap admin - created on startup only if no admin employee exists yet.
# Required so POST /api/v1/employee (admin-only) is reachable at all on a fresh database.
SEED_ADMIN_EMPLOYEE_ID=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE_NUMBER=